APP_ENV=dev
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./data/app.db
SESSION_COOKIE_NAME=boyan_session
SESSION_SECURE=false
SESSION_SAMESITE=lax
CSRF_SECRET=replace-with-a-different-long-random-value
PII_ENCRYPTION_KEY=
PII_BLIND_INDEX_KEY=
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=D:/boyan-data/attachments
LOCAL_TEMP_ROOT=D:/boyan-data/temp
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_PDF_BYTES=20971520
UPLOAD_MAX_OFFICE_BYTES=20971520
UPLOAD_STAGED_TTL_HOURS=24
FILE_LOCAL_RETENTION_DAYS=30
LOG_LEVEL=INFO
BACKUP_LOCAL_DIR=./backups
BACKUP_OSS_PREFIX=backups/sqlite
